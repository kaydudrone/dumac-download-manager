{
  "manifest_version": 3,
  "name": "Dumac Download Manager",
  "version": "1.0.0",
  "description": "Download videos and files on macOS: a download button on YouTube and other video sites, and browser downloads handed to the Dumac Download Manager app.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "clipboardRead",
    "downloads",
    "cookies"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*",
        "https://www.instagram.com/*",
        "https://www.tiktok.com/*",
        "https://www.facebook.com/*",
        "https://web.facebook.com/*",
        "https://x.com/*",
        "https://twitter.com/*",
        "https://vimeo.com/*",
        "https://www.dailymotion.com/*",
        "https://www.xiaohongshu.com/*",
        "https://www.bilibili.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ]
    }
  ],
  "action": {
    "default_title": "Dumac Download Manager"
  },
  "host_permissions": [
    "<all_urls>"
  ]
}